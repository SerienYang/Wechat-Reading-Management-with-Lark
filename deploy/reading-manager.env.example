# Secrets: enter these with deploy/configure-vps-secrets.sh.
WEREAD_API_KEY=
LLM_API_KEY=

# OpenAI-compatible model endpoint.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=3

# Lark CLI identity. The initial VPS deployment uses one-time user authorization.
LARK_IDENTITY=user

# Lark Base resources. Copy IDs from the target Base after creating the schema.
LARK_BASE_TOKEN=
LARK_BASE_URL=
LARK_TABLE_BOOKS=
LARK_TABLE_READING_RECORDS=
LARK_TABLE_NOTES=
LARK_TABLE_DAILY_STATS=
LARK_TABLE_TAGS=
LARK_TABLE_SYNC_RUNS=

# Optional failure notification target. Configure at most one.
READING_MANAGER_LARK_NOTIFY_USER_ID=
READING_MANAGER_LARK_NOTIFY_CHAT_ID=

PYTHONDONTWRITEBYTECODE=1
